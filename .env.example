# Supabase — Project Settings > API no painel do Supabase
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
#
# A anon key é pública por design: ela vai no bundle do navegador e não é
# segredo. A proteção real dos dados vem das policies de Row Level Security
# no banco. Nunca coloque aqui a service_role key.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
